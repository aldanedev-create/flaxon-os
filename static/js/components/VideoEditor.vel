<template>
  <section class="window video-editor stack">
    <div class="editor-heading"><div><h2>Flaxon Studio</h2><p class="muted">Local-first video editor</p></div><label class="button"><input type="file" accept="video/*" @change="loadVideo" hidden />Import video</label></div>
    <video id="editor-video" class="editor-preview" controls></video>
    <div class="timeline"><div class="timeline-track"><div v-if="!clips.length" class="timeline-empty">Import a video to begin</div><button v-for="clip in clips" :key="clip.id" class="timeline-clip" :class="{ selected: selectedClip === clip.id }" :style="{ width: clip.width + '%' }" @click="selectClip(clip.id)">{{ clip.name }}</button></div><div class="time-row"><span>{{ clips.length }} clip(s)</span><span>Selected in {{ inPoint.toFixed(1) }}s</span><span>Out {{ outPoint.toFixed(1) }}s</span><span>{{ duration.toFixed(1) }}s</span></div></div>
    <div class="editor-controls"><label>In <input type="range" min="0" :max="duration" step="0.1" :model="inPoint" /></label><label>Out <input type="range" min="0" :max="duration" step="0.1" :model="outPoint" /></label><button @click="setIn">Set in</button><button @click="setOut">Set out</button><button @click="saveProject">Save project</button><button @click="exportClip">Export clip</button><button @click="exportTimeline">Export timeline</button></div>
    <p class="muted">{{ message }}</p>
  </section>
</template>
<script>
export default {
  data() { return { filename: "", mediaId: "", duration: 0, inPoint: 0, outPoint: 0, clipWidth: 100, clips: [], selectedClip: "", message: "Import a local video. The source stays in this browser." }; },
  mounted() { this.restoreProject(); },
  methods: {
    async loadVideo(event) { const file = event.target.files && event.target.files[0]; if (!file) return; this.mediaId = "video-" + Date.now(); await window.FlxonOS.db.put("media", { id: this.mediaId, name: file.name, type: file.type, size: file.size, blob: file, createdAt: new Date().toISOString() }); window.dispatchEvent(new CustomEvent("flaxon:media-changed")); const video = document.getElementById("editor-video"); video.src = URL.createObjectURL(file); video.onloadedmetadata = () => { this.duration = video.duration || 0; this.outPoint = video.duration; this.clipWidth = 100; this.addClip(); }; this.filename = file.name; this.message = "Saved locally. Use the in/out controls to define a clip."; },
    addClip() { const clip = { id: "clip-" + Date.now(), mediaId: this.mediaId, name: this.filename, inPoint: 0, outPoint: this.duration, width: Math.max(18, Math.min(100, this.duration || 100)) }; this.clips.push(clip); this.selectedClip = clip.id; this.inPoint = clip.inPoint; this.outPoint = clip.outPoint; },
    selectClip(id) { const clip = this.clips.find(item => item.id === id); if (!clip) return; this.selectedClip = id; this.mediaId = clip.mediaId; this.filename = clip.name; this.inPoint = clip.inPoint; this.outPoint = clip.outPoint; },
    setIn() { const video = document.getElementById("editor-video"); this.inPoint = video ? video.currentTime : this.inPoint; const clip = this.clips.find(item => item.id === this.selectedClip); if (clip) clip.inPoint = this.inPoint; this.message = "In point updated."; },
    setOut() { const video = document.getElementById("editor-video"); this.outPoint = video ? video.currentTime : this.outPoint; const clip = this.clips.find(item => item.id === this.selectedClip); if (clip) clip.outPoint = this.outPoint; this.message = "Out point updated."; },
    async saveProject() { await window.FlxonOS.db.put("workspace", { id: "video-project", mediaId: this.mediaId, filename: this.filename, inPoint: this.inPoint, outPoint: this.outPoint, duration: this.duration, clips: this.clips, updatedAt: new Date().toISOString() }); this.message = "Multi-clip edit decision list saved locally."; },
    async exportClip() { const video = document.getElementById("editor-video"); if (!video || !video.src || !window.FlxonOS.media?.exportClip) { this.message = "This browser does not support WebM clip export."; return; } if (this.outPoint <= this.inPoint) { this.message = "Set an out point after the in point."; return; } this.message = "Exporting WebM clip..."; try { const name = (this.filename || "flaxon-clip").replace(/\.[^.]+$/, "") + "-clip.webm"; await window.FlxonOS.media.exportClip(video, this.inPoint, this.outPoint, name); this.message = "WebM clip exported."; } catch (error) { this.message = "Clip export failed: " + error.message; } },
    async exportTimeline() { const video = document.getElementById("editor-video"); if (!video || !window.FlxonOS.media?.exportTimeline || !this.clips.length) { this.message = "Import at least one clip in a browser with WebM recording support."; return; } this.message = "Exporting timeline..."; try { await window.FlxonOS.media.exportTimeline(video, this.clips, clip => window.FlxonOS.db.get("media", clip.mediaId), "flaxon-timeline.webm"); this.message = "Timeline exported to WebM. Audio support depends on browser capture behavior."; } catch (error) { this.message = "Timeline export failed: " + error.message; } },
    async restoreProject() { const project = await window.FlxonOS.db.get("workspace", "video-project"); if (!project || !project.mediaId) return; const media = await window.FlxonOS.db.get("media", project.mediaId); if (!media || !media.blob) return; this.mediaId = project.mediaId; this.filename = project.filename; this.inPoint = project.inPoint || 0; this.outPoint = project.outPoint || project.duration || 0; this.duration = project.duration || 0; this.clips = project.clips || []; this.selectedClip = this.clips[0] ? this.clips[0].id : ""; const video = document.getElementById("editor-video"); video.src = URL.createObjectURL(media.blob); this.message = "Restored local project: " + this.filename; }
  }
};
</script>
