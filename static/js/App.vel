<template>
  <div class="shell">
    <aside class="sidebar">
      <div class="brand">Flaxon OS</div>
      <nav class="nav">
        <button :class="{ active: view === 'home' }" @click="open('home')">Overview</button>
        <button :class="{ active: view === 'network' }" @click="open('network')">Bandwidth</button>
        <button :class="{ active: view === 'scanner' }" @click="open('scanner')">Scanner</button>
        <button :class="{ active: view === 'playground' }" @click="open('playground')">Playground</button>
        <button :class="{ active: view === 'study' }" @click="open('study')">Study</button>
        <button :class="{ active: view === 'errors' }" @click="open('errors')">Error solver</button>
        <button :class="{ active: view === 'video' }" @click="open('video')">Video studio</button>
      </nav>
    </aside>
    <section class="workspace">
      <header class="topbar"><strong>{{ title }}</strong><div class="row top-actions"><span class="muted">{{ status }}</span><button @click="installApp">Install</button><button @click="toggleWallpapers">Appearance</button><button v-show="view !== 'home'" class="exit-button" @click="exitPage">Exit</button><button class="window-control" @click="minimizeWindow">_</button><button class="window-control" @click="maximizeWindow">[]</button></div></header>
      <main class="content">
        <div v-show="view === 'home'">
          <section class="window"><h2>Workspace overview</h2><p class="muted">A local-first developer and study workspace. Your notes and recordings remain in this browser.</p><div class="grid"><div class="stat"><strong>{{ metrics.windows }}</strong><span class="muted">Open tools</span></div><div class="stat"><strong>{{ metrics.notes }}</strong><span class="muted">Local notes</span></div><div class="stat"><strong>{{ metrics.online }}</strong><span class="muted">Network status</span></div></div></section>
          <section class="window"><h2>Security boundary</h2><p class="muted">The scanner is restricted to public HTTP(S) targets. The hosted playground checks Python syntax and previews HTML/CSS/JS; it does not execute arbitrary server-side code.</p></section>
        </div>
        <div v-show="view === 'network'"><section class="window"><h2>Bandwidth monitor</h2><p>Measure a real request to this server. Nothing is uploaded or stored.</p><button @click="measure">Measure now</button><span class="muted">{{ bandwidth.message }}</span><div class="grid"><div class="stat"><strong>{{ bandwidth.latency }} ms</strong><span class="muted">Round trip</span></div><div class="stat"><strong>{{ bandwidth.downlink }} Mbps</strong><span class="muted">Measured download</span></div><div class="stat"><strong>{{ bandwidth.type }}</strong><span class="muted">Connection type</span></div></div></section></div>
        <div v-show="view === 'scanner'"><section class="window stack"><h2>Authorized security scanner</h2><p class="muted">Only scan systems you own or have permission to test.</p><div class="row"><input v-model="scanUrl" placeholder="https://example.com" /><button @click="scan">Analyze</button><button @click="checkPhishing">Check scam risk</button></div><p v-show="scanError" class="danger">{{ scanError }}</p><p v-show="phishingResult" class="muted">Scam checker: {{ phishingResult }}</p><div v-show="scanResult"><p>Status: {{ scanResult.status }} - Pages discovered: {{ scanResult.pages }}</p><ul><li v-for="finding in scanResult.findings" :key="finding.key">{{ finding.name }}: {{ finding.present ? 'present' : 'missing' }}</li></ul></div></section></div>
        <div v-show="view === 'playground'"><section class="window stack"><h2>Developer playground</h2><p class="muted">Python is syntax-checked only in the hosted deployment. HTML, CSS, and JS preview runs in a sandboxed browser iframe.</p><textarea class="code" v-model="pythonSource"></textarea><div class="row"><button @click="checkPython">Check Python syntax</button><span>{{ pythonResult }}</span></div><textarea class="code" v-model="htmlSource"></textarea><textarea class="code" v-model="cssSource"></textarea><textarea class="code" v-model="jsSource"></textarea><button @click="preview">Preview HTML/CSS/JS</button><iframe id="preview-frame" class="preview" sandbox="allow-scripts"></iframe></section></div>
        <div v-show="view === 'study'"><section class="window stack study-notes"><h2>Study workspace</h2><p class="muted">Write notes, save them locally, and record audio or video without an account.</p><input v-model="noteTitle" placeholder="Note title" /><textarea v-model="noteBody" placeholder="Write your notes..."></textarea><div class="row"><button @click="saveNote">Save note</button><button @click="record">{{ recording ? 'Stop recording' : 'Record audio' }}</button><button @click="recordVideo">{{ videoRecording ? 'Stop video' : 'Record video' }}</button></div><p class="muted">{{ noteMessage }}</p><ul><li v-for="note in notes" :key="note.id"><strong>{{ note.title }}</strong></li></ul></section></div>
        <div v-show="view === 'errors'"><section class="window stack"><h2>Developer error solver</h2><p class="muted">Paste a traceback for deterministic, privacy-preserving troubleshooting hints.</p><textarea class="code" v-model="diagnostic"></textarea><div class="row"><button @click="solveError">Analyze error</button><span>{{ errorType }}</span></div><p v-show="errorMessage"><strong>{{ errorMessage }}</strong></p><p v-show="errorLocation" class="muted">{{ errorLocation }}</p><pre v-show="errorSource" class="code error-source">{{ errorSource }}</pre><ul><li v-for="hint in errorHints" :key="hint">{{ hint }}</li></ul></section></div>
        <div v-show="view === 'external'"><section class="window stack external-app-window"><div class="external-app-heading"><div><h2>{{ externalAppTitle }}</h2><p class="muted">Running inside Flaxon OS</p></div><div class="external-app-tools"><button @click="open('study')">Study files</button><button @click="open('video')">Media library</button><a class="button external-link" :href="externalAppUrl" target="_blank" rel="noopener noreferrer">Open in new tab</a></div></div><iframe class="external-app-frame" :src="externalAppUrl" :title="externalAppTitle" allow="camera; microphone; display-capture; fullscreen" referrerpolicy="strict-origin-when-cross-origin"></iframe><p class="muted external-app-note">Your Flaxon files and media remain available while using this embedded app.</p></section></div>
      </main>
    </section>
  </div>
</template>
<script>
export default {
  data() { return { view: "home", title: "Overview", externalAppTitle: "", externalAppUrl: "", status: "Local-first", scanUrl: "https://example.com", scanResult: null, scanError: "", phishingResult: "", pythonSource: "print('Hello from the playground')", pythonResult: "", htmlSource: "<h1>Hello Flaxon</h1>", cssSource: "body { font-family: sans-serif; padding: 2rem; }", jsSource: "console.log('preview');", diagnostic: "", errorType: "", errorMessage: "", errorLocation: "", errorSource: "", errorHints: [], noteTitle: "", noteBody: "", noteMessage: "", notes: [], recording: false, videoRecording: false, windowMinimized: false, windowMaximized: false, metrics: { windows: 0, notes: 0, online: "online" }, bandwidth: { latency: 0, downlink: "-", type: "unknown", message: "Ready to measure." } }; },
  mounted() { document.body.classList.add("desktop-mode"); document.body.dataset.view = this.view; this.loadNotes(); this.measure(); this.setModuleVisibility(this.view); window.addEventListener("flaxon:navigate", event => this.open(event.detail)); window.addEventListener("flaxon:external", event => this.openExternal(event.detail)); },
  methods: {
    async installApp() { try { if (window.FlxonOS.pwa?.canInstall()) { this.status = await window.FlxonOS.pwa.install() ? "Installed" : "Install cancelled"; } else this.status = "Use the browser install menu"; } catch (error) { this.status = error.message; } },
    toggleWallpapers() { const panel = document.querySelector("#wallpaper-module"); if (panel) panel.hidden = !panel.hidden; },
    setModuleVisibility(view) { const visible = { "python-module": view === "playground", "surface-module": false, "files-module": view === "study", "media-module": view === "video", "video-module": view === "video", "workspace-module": false }; for (const [id, show] of Object.entries(visible)) { const host = document.getElementById(id); if (host) host.hidden = !show; } const content = document.querySelector(".content"); if (content) content.hidden = view === "video"; },
    open(view) { if (!view) return; this.windowMinimized = false; document.querySelector(".workspace")?.classList.remove("window-minimized"); this.view = view; document.body.dataset.view = view; this.title = view.charAt(0).toUpperCase() + view.slice(1); this.setModuleVisibility(view); window.FlxonOS.windows.open(view); this.metrics.windows = window.FlxonOS.windows.list().length; },
    openExternal(app) { if (!app?.url) return; this.externalAppTitle = app.title || "External app"; this.externalAppUrl = app.url; this.open("external"); this.title = this.externalAppTitle; },
    exitPage() { this.open("home"); },
    minimizeWindow() { this.windowMinimized = true; document.querySelector(".workspace")?.classList.add("window-minimized"); },
    maximizeWindow() { this.windowMaximized = !this.windowMaximized; document.body.classList.toggle("window-maximized", this.windowMaximized); },
    async loadNotes() { this.notes = await window.FlxonOS.db.list("notes"); this.metrics.notes = this.notes.length; },
    async saveNote() { if (!this.noteTitle.trim()) return; await window.FlxonOS.db.put("notes", { id: Date.now(), title: this.noteTitle, body: this.noteBody, updatedAt: new Date().toISOString() }); this.noteMessage = "Saved in IndexedDB."; this.noteTitle = ""; this.noteBody = ""; await this.loadNotes(); },
    async measure() { const started = performance.now(); this.bandwidth.message = "Measuring..."; try { const ping = await fetch("/api/network/ping?ts=" + Date.now(), { cache: "no-store" }); if (!ping.ok) throw new Error("Ping request failed (" + ping.status + ")."); this.bandwidth.latency = Math.round(performance.now() - started); const downloadStarted = performance.now(); const response = await fetch("/api/network/download?ts=" + Date.now(), { cache: "no-store" }); if (!response.ok) throw new Error("Download probe failed (" + response.status + ")."); const payload = await response.arrayBuffer(); const seconds = Math.max((performance.now() - downloadStarted) / 1000, 0.001); this.bandwidth.downlink = ((payload.byteLength * 8) / seconds / 1000000).toFixed(1); const connection = navigator.connection || {}; this.bandwidth.type = connection.effectiveType || "unknown"; this.bandwidth.message = "Measured " + payload.byteLength + " bytes locally."; this.metrics.online = "online"; } catch (error) { this.status = "Offline"; this.metrics.online = "offline"; this.bandwidth.message = error.message; } },
    async scan() { this.scanError = ""; this.scanResult = null; try { const response = await fetch("/api/scanner/check?url=" + encodeURIComponent(this.scanUrl) + "&crawl=1", { cache: "no-store" }); const data = await response.json(); if (data.error) throw new Error(data.error); this.scanResult = data; } catch (error) { this.scanError = error.message; } },
    async checkPhishing() { try { const response = await fetch("/api/checkers/phishing?url=" + encodeURIComponent(this.scanUrl), { cache: "no-store" }); const data = await response.json(); if (data.error) throw new Error(data.error); this.phishingResult = data.risk + (data.reasons && data.reasons.length ? ": " + data.reasons.join(" ") : ""); } catch (error) { this.phishingResult = error.message; } },
    async checkPython() { try { const response = await fetch("/api/playground/python/check?source=" + encodeURIComponent(this.pythonSource), { cache: "no-store" }); const data = await response.json(); this.pythonResult = data.ok ? data.message : data.error; } catch (error) { this.pythonResult = error.message; } },
    preview() { const frame = document.getElementById("preview-frame"); const openStyle = String.fromCharCode(60) + "style>"; const closeStyle = String.fromCharCode(60) + "/style>"; const openScript = String.fromCharCode(60) + "script>"; const closeScript = String.fromCharCode(60) + "/script>"; if (frame) frame.srcdoc = this.htmlSource + openStyle + this.cssSource + closeStyle + openScript + this.jsSource + closeScript; },
    async record() { try { if (!this.recording) { await window.FlxonOS.media.start("audio"); this.recording = true; this.noteMessage = "Audio recording started locally."; } else { await window.FlxonOS.media.stop("audio"); this.recording = false; this.noteMessage = "Audio recording saved in IndexedDB."; } } catch (error) { this.recording = false; this.noteMessage = error.message; } },
    async recordVideo() { try { if (!this.videoRecording) { await window.FlxonOS.media.start("video"); this.videoRecording = true; this.noteMessage = "Video recording started locally."; } else { await window.FlxonOS.media.stop("video"); this.videoRecording = false; this.noteMessage = "Video recording saved in IndexedDB."; } } catch (error) { this.videoRecording = false; this.noteMessage = error.message; } },
    async solveError() { try { const response = await fetch("/api/devtools/solve?diagnostic=" + encodeURIComponent(this.diagnostic), { cache: "no-store" }); const data = await response.json(); this.errorType = data.error_type || data.error || ""; this.errorMessage = data.message || ""; this.errorLocation = data.location ? data.location.file + ":" + data.location.line + (data.location.function ? " in " + data.location.function : "") : ""; this.errorSource = data.source_line || ""; this.errorHints = data.hints || []; } catch (error) { this.errorType = error.message; this.errorMessage = ""; this.errorLocation = ""; this.errorSource = ""; this.errorHints = []; } }
  }
};
</script>
